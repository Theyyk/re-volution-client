{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RE:volution signed manifest envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "keyId", "payload", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "ecdsa-p256-sha256" },
    "keyId": { "type": "string", "minLength": 1 },
    "payload": { "type": "string", "minLength": 1, "contentEncoding": "base64" },
    "signature": { "type": "string", "minLength": 1, "contentEncoding": "base64" }
  }
}
